root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{yml,yaml,json,toml,md}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Upstream code, kept exactly as released.
[crates/euphoria-core/vendor/**]
indent_style = unset
indent_size = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
end_of_line = unset
